#!/bin/sh
# postrm script for llx-kdenlive.
#
# See: dh_installdeb(1).

set -e

# Summary of how this script can be called:
#        * <postrm> 'remove'
#        * <postrm> 'purge'
#        * <old-postrm> 'upgrade' <new-version>
#        * <new-postrm> 'failed-upgrade' <old-version>
#        * <new-postrm> 'abort-install'
#        * <new-postrm> 'abort-install' <old-version>
#        * <new-postrm> 'abort-upgrade' <old-version>
#        * <disappearer's-postrm> 'disappear' <overwriter>
#          <overwriter-version>
# for details, see https://www.debian.org/doc/debian-policy/ or
# the debian-policy package.

PKG="llx-kdenlive"
DIVERT_FILE="/usr/share/kdenlive/scripts/whisper/whispertotext.py"
REAL_FILE="$DIVERT_FILE.real"
VENV_PATH="/opt/ai/kdenlive/kdenlive-venv"

case "$1" in
    purge|remove|abort-install|abort-upgrade|disappear)
        dpkg-divert --list | grep $PKG | grep -q "$DIVERT_FILE" && rc=1 || rc=0
        if [ "$rc" = "1" ]; then
            dpkg-divert --package $PKG --remove --rename --divert "$REAL_FILE" "$DIVERT_FILE"
        fi
        if [ -d "$VENV_PATH" ]; then
            rm -rf "$VENV_PATH"
        fi
    ;;
    upgrade|failed-upgrade)
    ;;
    *)
        echo "postrm called with unknown argument '$1'" >&2
        exit 1
    ;;
esac

# dh_installdeb will replace this with shell code automatically
# generated by other debhelper scripts.

#DEBHELPER#

exit 0
