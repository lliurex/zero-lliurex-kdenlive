#!/bin/bash
# preinst script for llx-kdenlive.
#
# See: dh_installdeb(1).

set -e

# Summary of how this script can be called:
#        * <new-preinst> 'install'
#        * <new-preinst> 'install' <old-version>
#        * <new-preinst> 'upgrade' <old-version>
#        * <old-preinst> 'abort-upgrade' <new-version>
# for details, see https://www.debian.org/doc/debian-policy/ or
# the debian-policy package.

PKG="llx-kdenlive"
DIVERT_FILE="/usr/share/kdenlive/scripts/whisper/whispertotext.py"
REAL_FILE="$DIVERT_FILE.real"

G=14
REQUIRED_KB=$(( $G * 1024 * 1024 ))
TARGET_DIR="/opt/ai/kdenlive"
mkdir -p $TARGET_DIR
AVAILABLE_KB=$(df --output=avail "$TARGET_DIR" | tail -1)
rmdir $TARGET_DIR 2>/dev/null || true

if [[ "$AVAILABLE_KB" -lt "$REQUIRED_KB" && "$1" != "upgrade" ]]; then
    AVAILABLE_GB=$(( AVAILABLE_KB / 1024 / 1024 ))

    echo "" >&2
    echo "===========================================================" >&2
    echo " ERROR CRÍTICO DE INSTALACIÓN" >&2
    echo "===========================================================" >&2
    echo " Este paquete requiere al menos $G GB de espacio libre" >&2
    echo " para instalarse correctamente." >&2
    echo " Espacio libre actual en la partición: ${AVAILABLE_GB} GB." >&2
    echo " Por favor, libera espacio y vuelve a intentarlo." >&2
    echo "===========================================================" >&2
    echo "" >&2

    # Abortamos la instalación devolviendo un error
    exit 1
fi

case "$1" in
    install|upgrade)
        dpkg-divert --list | grep $PKG | grep -q "$DIVERT_FILE" && rc=1 || rc=0
        if [ "$rc" = "0" ] ; then
            dpkg-divert --package $PKG --add --rename --divert "$REAL_FILE" "$DIVERT_FILE"
        fi
    ;;

    abort-upgrade)
    ;;

    *)
        echo "preinst called with unknown argument '$1'" >&2
        exit 1
    ;;
esac

# dh_installdeb will replace this with shell code automatically
# generated by other debhelper scripts.

#DEBHELPER#

exit 0
